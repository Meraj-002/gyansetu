# GyanSetu backend configuration. Copy to `.env` and adjust.
# All values are read with the GYANSETU_ prefix (the Hugging Face token is the
# exception: keep it as HF_TOKEN below, matching huggingface_hub's own lookup).

# Runtime environment: development | production
GYANSETU_ENV=development

# Comma-separated CORS origins (the Flutter web build origin, e.g. http://localhost:8080)
GYANSETU_CORS_ORIGINS=*

# Database.
# PostgreSQL (recommended for production):
#   postgresql+psycopg://gyansetu:CHANGE_ME@localhost:5432/gyansetu
# SQLite (zero-setup local development / tests):
GYANSETU_DATABASE_URL=sqlite:///./gyansetu_dev.db

# Auth secrets. In production generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GYANSETU_SECRET_KEY=dev-only-insecure-secret-change-me
GYANSETU_ACCESS_TOKEN_EXPIRES_MINUTES=10080

# ---------------------------------------------------------------------------
# Real translation model (IndicTrans2) — OPTIONAL, OFF by default.
# ---------------------------------------------------------------------------
#
# The server starts and answers the offline-first phrasebook WITHOUT any of
# this. A real Hindi <-> Santali NMT model is enabled by a runtime flag and a
# Hugging Face token whose account accepted the model terms.

# Which backend translation provider {@code POST /api/v1/translate} uses.
#   dev          - the hand-written development phrasebook rule table (default, no model)
#   indic_trans2 - AI4Bharat IndicTrans2 real NMT model (Hindi <-> Santali).
#                  The model loads LAZILY on the first request, not at startup.
#                  If it cannot load (gated / deps missing / offline) requests
#                  return an explicit 503 `model_unavailable` — never a guess.
GYANSETU_TRANSLATION_PROVIDER=dev

# IndicTrans2 checkpoint (only read when translation_provider == indic_trans2).
# This verified INT8 ONNX export runs through ONNX Runtime on CPU. Swap in a
# compatible model id here without a code change.
# GYANSETU_TRANSLATION_MODEL_ID=TigreGotico/indictrans2-indic-indic-dist-320M-onnx

# Hugging Face token for the GATED IndicTrans2 checkpoint.
#
# 1. Create a Hugging Face account and generate a token:
#      https://huggingface.co/settings/tokens
# 2. Accept the model terms (sign in + agree to share contact info):
#      https://huggingface.co/ai4bharat/indictrans2-indic-indic-dist-320M
# 3. Put the token in THIS file only (never commit it, never hardcode it):
#
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
#
# GYANSETU_HF_TOKEN is honoured as an alternative name for the same value.

# ---------------------------------------------------------------------------
# Real translation model — required dependencies (installed separately)
# ---------------------------------------------------------------------------
# The model provider needs the IndicTrans2 inference stack, which is deliberately
# NOT in requirements.txt so the base deployment stays light. Install together:
#
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install transformers
#   pip install optimum onnxruntime sentencepiece
#   pip install git+https://github.com/AI4Bharat/IndicTransToolkit.git
#
# Note: IndicTransToolkit requires Python >= 3.9. The model is downloaded
# automatically (into the Hugging Face cache) on first request once
# `GYANSETU_TRANSLATION_PROVIDER=indic_trans2`. The server never loads more than
# one copy of the checkpoint. A token may be needed when selecting a gated
# Hugging Face checkpoint instead.
